{
  "id": "x-opencode",
  "name": "X Opencode",
  "description": "OpenCode Go models through an AxonHub gateway (OpenAI format)",
  "categories": [
    "models"
  ],
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providers": [
    "x-opencode"
  ],
  "setup": {
    "providers": [
      {
        "id": "x-opencode",
        "envVars": [
          "X_OPENCODE_API_KEY"
        ]
      }
    ]
  },
  "modelCatalog": {
    "discovery": {
      "x-opencode": "refreshable"
    }
  },
  "providerAuthChoices": [
    {
      "provider": "x-opencode",
      "method": "api-key",
      "choiceId": "x-opencode-api-key",
      "appGuidedSecret": true,
      "choiceLabel": "OpenCode API key",
      "groupId": "x-opencode",
      "groupLabel": "X Opencode",
      "groupHint": "Only OpenCode Go models are listed",
      "optionKey": "xOpencodeApiKey",
      "cliFlag": "--x-opencode-api-key",
      "cliOption": "--x-opencode-api-key <key>",
      "cliDescription": "OpenCode API key"
    }
  ],
  "uiHints": {
    "baseUrl": {
      "label": "API address",
      "placeholder": "https://axonhub.example.com/v1",
      "help": "Overrides X_OPENCODE_BASE_URL"
    },
    "apiKey": {
      "label": "API key",
      "placeholder": "ah-...",
      "sensitive": true,
      "help": "Overrides the saved auth profile and X_OPENCODE_API_KEY"
    },
    "contextWindow": {
      "label": "Context window",
      "placeholder": "131072",
      "help": "Empty: the value AxonHub reports. Overrides X_OPENCODE_CONTEXT_WINDOW"
    },
    "streaming": {
      "label": "Streaming",
      "help": "On by default. Overrides X_OPENCODE_STREAMING"
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "baseUrl": {
        "type": "string"
      },
      "apiKey": {
        "type": "string"
      },
      "contextWindow": {
        "type": "integer",
        "minimum": 1
      },
      "streaming": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
